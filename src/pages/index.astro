---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <section class="hero" aria-label="Introduction">
    <div class="hero-media" role="img" aria-label="Placeholder for hero animation"></div>
    <div class="container">
      <p class="statement">One-line research statement goes here.</p>
    </div>
  </section>

  <section class="container" aria-labelledby="topics">
    <h2 id="topics">Research</h2>
    <ul class="topic-grid">
      {['Topic one', 'Topic two', 'Topic three'].map((t) => (
        <li class="topic-card">
          <div class="thumb" aria-hidden="true"></div>
          <h3>{t}</h3>
          <p class="muted">Short summary of this line of research.</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container prose" aria-labelledby="about">
    <h2 id="about">About</h2>
    <p>Short bio goes here.</p>
  </section>
</BaseLayout>

<style>
  .hero { margin-top: calc(-1 * var(--space-5)); margin-bottom: var(--space-5); }
  .hero-media {
    aspect-ratio: 21 / 8;
    max-height: 60vh;
    width: 100%;
    background:
      radial-gradient(circle at 30% 40%, color-mix(in srgb, var(--accent) 35%, transparent), transparent 60%),
      radial-gradient(circle at 75% 60%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 55%),
      var(--bg-subtle);
  }
  .statement { font-size: var(--step-2); max-width: 40ch; margin-top: var(--space-4); line-height: 1.3; }

  .topic-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
  .topic-card h3 { margin-top: var(--space-3); }
  .thumb { aspect-ratio: 16 / 10; border-radius: var(--radius); background: var(--bg-subtle); border: 1px solid var(--border); }
</style>
