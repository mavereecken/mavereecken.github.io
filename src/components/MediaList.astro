---
import { getCollection } from 'astro:content';
import { MEDIA, SITE } from '../site';

const VIDEO = /\.(mp4|webm|mov|m4v)$/i;
const fileName = (f: string) => f.split('/').pop();
const ext = (f: string) => f.split('.').pop()?.toUpperCase();

const items = (await getCollection('media')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title),
);
---

{items.length === 0 ? (
  <p class="muted">Nothing here yet.</p>
) : (
  <ul class="media-list">
    {items.map(({ id, data }) => {
      const license = data.license ?? MEDIA.license;
      const url = (f: string) => `/media/${id}/${f}`;
      const src = url(data.file);
      return (
        <li class="media-item" id={id}>
          <div class="preview">
            {VIDEO.test(data.file) ? (
              <video
                controls
                muted
                loop
                playsinline
                preload={data.poster ? 'none' : 'metadata'}
                poster={data.poster && url(data.poster)}
                src={src}
              />
            ) : (
              <img src={src} alt={data.title} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="info">
            <h3><a href={`#${id}`}>{data.title}</a></h3>
            <p>{data.description}</p>
            <p class="meta muted">
              {data.date.getFullYear()} · 
              <a href={license.url}>{license.name}</a> · credit: {data.credit ?? SITE.author}
            </p>
            <p class="actions">
              <a class="download" href={src} download={fileName(data.file)}>Download {ext(data.file)}</a>
              {data.links.map((l) => <a href={l.href}>{l.label}</a>)}
            </p>
          </div>
        </li>
      );
    })}
  </ul>
)}

<style>
  /* One item per row at full page width: the media are detailed. */
  .media-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
  }
  .preview {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    overflow: hidden;
  }
  .preview > * { display: block; width: 100%; height: auto; }
  .info { max-width: var(--measure); }
  .info h3 { margin-top: var(--space-3); }
  .info h3 a { color: inherit; text-decoration: none; }
  .info h3 a:hover { text-decoration: underline; }
  .meta { font-size: var(--step--1); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
  .download {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-fg);
    text-decoration: none;
  }
</style>
