---
import { MEDIA, SITE } from '../site';
---

<header class="intro">
  <h1>{SITE.author}</h1>
  {(SITE.position || SITE.affiliation) && (
    <p class="role">{[SITE.position, SITE.affiliation].filter(Boolean).join(' · ')}</p>
  )}
  <p class="muted">
    Graphics, animations and videos from my research. You're welcome to use them in
    your own talks, papers and teaching with appropriate credit.
  </p>
</header>

<style>
  .intro { max-width: var(--measure); margin-bottom: var(--space-5); }
  .intro h1 { margin-bottom: var(--space-2); }
  .role { font-size: var(--step-1); color: var(--fg-muted); }
</style>
